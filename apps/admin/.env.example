# Copy to .env.local and fill in from Supabase (Project Settings → API Keys),
# or from `pnpm supabase status` when running Supabase locally.
# On Vercel, add the same two variables under Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
