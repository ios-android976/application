{
  "name": "coffee-shop",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "pnpm --filter @coffee/admin dev",
    "dev:mobile": "pnpm --filter @coffee/mobile start",
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@coffee/admin",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
